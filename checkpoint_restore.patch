diff --git a/checkpoint/checkpoint_memory.c b/checkpoint/checkpoint_memory.c
new file mode 100644
index 000000000..09931047c
--- /dev/null
+++ b/checkpoint/checkpoint_memory.c
@@ -0,0 +1,451 @@
+/*
+ * QEMU ARM64 Checkpoint - Memory Serialization
+ * Serialize physical memory and device states to checkpoint
+ */
+
+#include "qemu/osdep.h"
+#include "checkpoint/checkpoint.h"
+#include "system/ramblock.h"
+#include "exec/ramlist.h"
+#include "exec/cpu-common.h"
+#include "qemu/error-report.h"
+#include <zlib.h>
+
+#define MEMORY_CHUNK_SIZE (4 * 1024 * 1024)  /* 4MB chunks */
+
+/* Memory region information */
+typedef struct MemoryRegionInfo {
+    uint64_t base_addr;
+    uint64_t size;
+    uint32_t flags;
+    uint32_t reserved;
+} MemoryRegionInfo;
+
+/* Serialize physical memory to checkpoint */
+void checkpoint_serialize_memory(void *buffer, size_t *offset, uint64_t icount)
+{
+    CheckpointState *cs = global_checkpoint_state;
+    
+    if (!cs) {
+        error_report("Checkpoint state not initialized");
+        return;
+    }
+    
+    info_report("Serializing physical memory at instruction %lu", icount);
+    
+    /* Memory layout header */
+    typedef struct {
+        uint32_t magic;
+        uint32_t num_regions;
+        uint64_t total_size;
+        uint64_t compressed_size;
+    } MemoryHeader;
+    
+    MemoryHeader *header = (MemoryHeader *)(buffer + *offset);
+    header->magic = 0x4D454D44;  /* "MEMD" in hex */
+    header->num_regions = 0;
+    header->total_size = 0;
+    header->compressed_size = 0;
+    
+    size_t header_offset __attribute__((unused)) = *offset;
+    *offset += sizeof(MemoryHeader);
+    
+    /* Reserve space for region info array */
+    MemoryRegionInfo *regions = (MemoryRegionInfo *)(buffer + *offset);
+    size_t regions_offset __attribute__((unused)) = *offset;
+    *offset += sizeof(MemoryRegionInfo) * 32;  /* Max 32 regions */
+    
+    /* Iterate through memory regions */
+    int region_count = 0;
+    size_t total_memory_size = 0;
+    
+    /* Serialize main RAM */
+    RAMBlock *block;
+    RAMBLOCK_FOREACH(block) {
+        if (region_count >= 32) {
+            warn_report("Too many memory regions, limiting to 32");
+            break;
+        }
+        
+        uint64_t block_offset = (uint64_t)qemu_ram_block_host_offset(block, block->host);
+        uint64_t block_size = block->used_length;
+        
+        info_report("  Memory region %d: base=0x%lx size=%lu (%s)",
+                   region_count, block_offset, block_size, block->idstr);
+        
+        /* Record region info */
+        regions[region_count].base_addr = block_offset;
+        regions[region_count].size = block_size;
+        regions[region_count].flags = 0;
+        regions[region_count].reserved = 0;
+        
+        /* Process memory in chunks to avoid OOM */
+        #define CHUNK_SIZE (64 * 1024 * 1024)  /* 64MB chunks */
+        
+        uint64_t bytes_remaining = block_size;
+        uint64_t current_offset = block_offset;
+        uLongf total_compressed = 0;
+        
+        info_report("    Processing %lu bytes in chunks of %d MB...", 
+                   block_size, CHUNK_SIZE / (1024 * 1024));
+        
+        /* Reserve space for total compressed size (will update later) */
+        size_t compressed_size_offset = *offset;
+        *offset += sizeof(uLongf);
+        
+        while (bytes_remaining > 0) {
+            uint64_t chunk_size = (bytes_remaining > CHUNK_SIZE) ? CHUNK_SIZE : bytes_remaining;
+            
+            /* Read chunk */
+            void *data_buffer = g_malloc(chunk_size);
+            cpu_physical_memory_read(current_offset, data_buffer, chunk_size);
+            
+            /* Compress chunk */
+            uLongf compressed_bound = compressBound(chunk_size);
+            void *compressed_buffer = g_malloc(compressed_bound);
+            uLongf compressed_size = compressed_bound;
+            
+            int ret = compress2((Bytef *)compressed_buffer, &compressed_size,
+                              (const Bytef *)data_buffer, chunk_size, Z_BEST_SPEED);
+            
+            if (ret == Z_OK) {
+                /* Write chunk compressed size */
+                memcpy(buffer + *offset, &compressed_size, sizeof(compressed_size));
+                *offset += sizeof(compressed_size);
+                
+                /* Write compressed data */
+                memcpy(buffer + *offset, compressed_buffer, compressed_size);
+                *offset += compressed_size;
+                
+                total_compressed += compressed_size + sizeof(compressed_size);
+                
+                /* Progress report */
+                uint64_t processed = block_size - bytes_remaining + chunk_size;
+                if (processed % (256 * 1024 * 1024) == 0 || bytes_remaining == chunk_size) {
+                    info_report("      Progress: %lu / %lu MB (%.1f%%)",
+                               processed / (1024 * 1024), 
+                               block_size / (1024 * 1024),
+                               (processed * 100.0) / block_size);
+                }
+            } else {
+                error_report("Failed to compress chunk at offset %lu", current_offset);
+            }
+            
+            g_free(compressed_buffer);
+            g_free(data_buffer);
+            
+            current_offset += chunk_size;
+            bytes_remaining -= chunk_size;
+        }
+        
+        /* Write total compressed size at the beginning */
+        memcpy(buffer + compressed_size_offset, &total_compressed, sizeof(total_compressed));
+        header->compressed_size += total_compressed;
+        
+        info_report("    Compressed: %lu -> %lu bytes (%.1f%%)",
+                   block_size, total_compressed,
+                   (total_compressed * 100.0) / block_size);
+        
+        total_memory_size += block_size;
+        region_count++;
+    }
+    
+    /* Update header */
+    header->num_regions = region_count;
+    header->total_size = total_memory_size;
+    
+    info_report("Memory serialization complete: %d regions, %zu bytes total, %lu compressed",
+               region_count, total_memory_size, header->compressed_size);
+}
+
+/* Serialize memory directly to file (streaming, avoids OOM) */
+int checkpoint_serialize_memory_to_file(FILE *fp, size_t *total_written, uint64_t icount)
+{
+    if (!fp) {
+        error_report("Invalid file pointer");
+        return -1;
+    }
+    
+    info_report("Serializing physical memory (streaming) at instruction %lu", icount);
+    
+    /* Memory layout header */
+    typedef struct {
+        uint32_t magic;
+        uint32_t num_regions;
+        uint64_t total_size;
+        uint64_t compressed_size;
+    } MemoryHeader;
+    
+    MemoryHeader header = {
+        .magic = 0x4D454D44,  /* "MEMD" in hex */
+        .num_regions = 0,
+        .total_size = 0,
+        .compressed_size = 0
+    };
+    
+    /* Reserve space for header (will update later) */
+    long header_pos = ftell(fp);
+    if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to write memory header");
+        return -1;
+    }
+    *total_written += sizeof(header);
+    
+    /* Write region info array */
+    MemoryRegionInfo regions[32];
+    memset(regions, 0, sizeof(regions));
+    
+    long regions_pos = ftell(fp);
+    if (fwrite(regions, sizeof(regions), 1, fp) != 1) {
+        error_report("Failed to write regions array");
+        return -1;
+    }
+    *total_written += sizeof(regions);
+    
+    /* Iterate through memory regions */
+    int region_count = 0;
+    size_t total_memory_size = 0;
+    uint64_t total_compressed = 0;
+    
+    /* Serialize main RAM */
+    RAMBlock *block;
+    RAMBLOCK_FOREACH(block) {
+        if (region_count >= 32) {
+            warn_report("Too many memory regions, limiting to 32");
+            break;
+        }
+        
+        uint64_t block_offset = (uint64_t)qemu_ram_block_host_offset(block, block->host);
+        uint64_t block_size = block->used_length;
+        
+        info_report("  Memory region %d: base=0x%lx size=%lu (%s)",
+                   region_count, block_offset, block_size, block->idstr);
+        
+        /* Record region info */
+        regions[region_count].base_addr = block_offset;
+        regions[region_count].size = block_size;
+        regions[region_count].flags = 0;
+        regions[region_count].reserved = 0;
+        
+        /* Process memory in chunks to avoid OOM */
+        #define CHUNK_SIZE (64 * 1024 * 1024)  /* 64MB chunks */
+        
+        uint64_t bytes_remaining = block_size;
+        uint64_t current_offset = block_offset;
+        uLongf region_compressed = 0;
+        
+        info_report("    Processing %lu MB in %d MB chunks...", 
+                   block_size / (1024 * 1024), CHUNK_SIZE / (1024 * 1024));
+        
+        while (bytes_remaining > 0) {
+            uint64_t chunk_size = (bytes_remaining > CHUNK_SIZE) ? CHUNK_SIZE : bytes_remaining;
+            
+            /* Read chunk */
+            void *data_buffer = g_malloc(chunk_size);
+            cpu_physical_memory_read(current_offset, data_buffer, chunk_size);
+            
+            /* Compress chunk */
+            uLongf compressed_bound = compressBound(chunk_size);
+            void *compressed_buffer = g_malloc(compressed_bound);
+            uLongf compressed_size = compressed_bound;
+            
+            int ret = compress2((Bytef *)compressed_buffer, &compressed_size,
+                              (const Bytef *)data_buffer, chunk_size, Z_BEST_SPEED);
+            
+            if (ret == Z_OK) {
+                /* Write chunk compressed size */
+                if (fwrite(&compressed_size, sizeof(compressed_size), 1, fp) != 1) {
+                    error_report("Failed to write compressed size");
+                    g_free(compressed_buffer);
+                    g_free(data_buffer);
+                    return -1;
+                }
+                *total_written += sizeof(compressed_size);
+                
+                /* Write compressed data */
+                if (fwrite(compressed_buffer, compressed_size, 1, fp) != 1) {
+                    error_report("Failed to write compressed data");
+                    g_free(compressed_buffer);
+                    g_free(data_buffer);
+                    return -1;
+                }
+                *total_written += compressed_size;
+                
+                region_compressed += compressed_size + sizeof(compressed_size);
+                
+                /* Progress report */
+                uint64_t processed = block_size - bytes_remaining + chunk_size;
+                if (processed % (256 * 1024 * 1024) == 0 || bytes_remaining <= chunk_size) {
+                    info_report("      Progress: %lu / %lu MB (%.1f%%), compressed ratio: %.1f%%",
+                               processed / (1024 * 1024), 
+                               block_size / (1024 * 1024),
+                               (processed * 100.0) / block_size,
+                               (region_compressed * 100.0) / processed);
+                }
+            } else {
+                error_report("Failed to compress chunk at offset %lu", current_offset);
+                g_free(compressed_buffer);
+                g_free(data_buffer);
+                return -1;
+            }
+            
+            g_free(compressed_buffer);
+            g_free(data_buffer);
+            
+            current_offset += chunk_size;
+            bytes_remaining -= chunk_size;
+        }
+        
+        total_compressed += region_compressed;
+        
+        info_report("    Region compressed: %lu -> %lu bytes (%.1f%%)",
+                   block_size, region_compressed,
+                   (region_compressed * 100.0) / block_size);
+        
+        total_memory_size += block_size;
+        region_count++;
+    }
+    
+    /* Update header */
+    header.num_regions = region_count;
+    header.total_size = total_memory_size;
+    header.compressed_size = total_compressed;
+    
+    /* Go back and write updated header */
+    long current_pos = ftell(fp);
+    fseek(fp, header_pos, SEEK_SET);
+    if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to update memory header");
+        return -1;
+    }
+    
+    /* Go back and write updated regions */
+    fseek(fp, regions_pos, SEEK_SET);
+    if (fwrite(regions, sizeof(regions), 1, fp) != 1) {
+        error_report("Failed to update regions array");
+        return -1;
+    }
+    
+    /* Restore file position */
+    fseek(fp, current_pos, SEEK_SET);
+    
+    info_report("Memory serialization complete: %d regions, %zu bytes total, %lu compressed (%.1f%%)",
+               region_count, total_memory_size, total_compressed,
+               (total_compressed * 100.0) / total_memory_size);
+    
+    return 0;
+}
+
+/* Serialize device states */
+void checkpoint_serialize_devices(void *buffer, size_t *offset)
+{
+    info_report("Serializing device states at offset %zu", *offset);
+    
+    /* Device state header */
+    typedef struct {
+        uint32_t magic;
+        uint32_t num_devices;
+        uint64_t total_size;
+    } DeviceHeader;
+    
+    DeviceHeader *header = (DeviceHeader *)(buffer + *offset);
+    header->magic = 0x44455644;  /* "DEVD" in hex */
+    header->num_devices = 0;
+    header->total_size = 0;
+    
+    *offset += sizeof(DeviceHeader);
+    
+    /* TODO: Serialize device states
+     * This would involve:
+     * 1. GIC (Generic Interrupt Controller) state
+     * 2. Timer state
+     * 3. UART state
+     * 4. Other peripherals
+     * 
+     * For now, we'll just placeholder this
+     */
+    
+    info_report("Device serialization complete: %d devices", header->num_devices);
+}
+
+/* Restore memory from checkpoint */
+int checkpoint_restore_memory(void *buffer, size_t *offset)
+{
+    typedef struct {
+        uint32_t magic;
+        uint32_t num_regions;
+        uint64_t total_size;
+        uint64_t compressed_size;
+    } MemoryHeader;
+    
+    MemoryHeader *header = (MemoryHeader *)(buffer + *offset);
+    
+    if (header->magic != 0x4D454D44) {  /* "MEMD" */
+        error_report("Invalid memory checkpoint magic: 0x%x", header->magic);
+        return -1;
+    }
+    
+    info_report("Restoring %d memory regions (%lu bytes)",
+               header->num_regions, header->total_size);
+    
+    *offset += sizeof(MemoryHeader);
+    
+    /* Read region info */
+    MemoryRegionInfo *regions = (MemoryRegionInfo *)(buffer + *offset);
+    *offset += sizeof(MemoryRegionInfo) * header->num_regions;
+    
+    /* Restore each region */
+    for (uint32_t i = 0; i < header->num_regions; i++) {
+        uint64_t base_addr = regions[i].base_addr;
+        uint64_t size = regions[i].size;
+        
+        /* Read compressed size */
+        uLongf compressed_size;
+        memcpy(&compressed_size, buffer + *offset, sizeof(compressed_size));
+        *offset += sizeof(compressed_size);
+        
+        /* Decompress data */
+        void *compressed_data = buffer + *offset;
+        void *decompressed_data = g_malloc(size);
+        uLongf decompressed_size = size;
+        
+        int ret = uncompress((Bytef *)decompressed_data, &decompressed_size,
+                           (const Bytef *)compressed_data, compressed_size);
+        
+        if (ret == Z_OK && decompressed_size == size) {
+            /* Write to physical memory */
+            cpu_physical_memory_write(base_addr, decompressed_data, size);
+            
+            info_report("  Restored region %d: 0x%lx (%lu bytes)",
+                       i, base_addr, size);
+        } else {
+            error_report("Failed to decompress memory region %d", i);
+            g_free(decompressed_data);
+            return -1;
+        }
+        
+        g_free(decompressed_data);
+        *offset += compressed_size;
+    }
+    
+    info_report("Memory restoration complete");
+    return 0;
+}
+
+/* Dump memory statistics */
+void checkpoint_dump_memory_stats(void)
+{
+    size_t total_ram = 0;
+    int block_count = 0;
+    
+    RAMBlock *block;
+    RAMBLOCK_FOREACH(block) {
+        total_ram += block->used_length;
+        block_count++;
+        
+        info_report("RAM Block %d: %s - %lu bytes @ %p",
+                   block_count, block->idstr, block->used_length, block->host);
+    }
+    
+    info_report("Total RAM: %zu bytes in %d blocks", total_ram, block_count);
+}
