+/*
+ * Save dynamic CP register array (Priority 5 - Complete Coverage)
+ * 
+ * This function implements QEMU's dynamic CP register mechanism to achieve
+ * 100% register coverage. It works by:
+ * 1. Calling write_cpustate_to_list() to populate the CP register arrays
+ * 2. Saving the (register_id, value) pairs to the checkpoint
+ * 
+ * This captures 200-500 system registers including:
+ * - GIC interrupt controller registers (ICC_*, ICV_*)
+ * - Implementation-defined registers (MIDR, ID_AA64*)
+ * - Feature-specific registers (SME, Trace, etc.)
+ * - All registers managed by QEMU's CP register hash table
+ */
+static void checkpoint_save_dynamic_cpregs(int cpu_idx, void *buffer, size_t *offset)
+{
+    CPUState *cpu = qemu_get_cpu(cpu_idx);
+    if (!cpu) {
+        return;
+    }
+
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    
+    /* Call QEMU's function to populate CP register arrays from CPU state */
+    if (!write_cpustate_to_list(arm_cpu, false)) {
+        error_report("Failed to write CPU state to CP register list for CPU %d", cpu_idx);
+        return;
+    }
+    
+    /* Save the CP register array header */
+    typedef struct {
+        uint32_t magic;              // Magic number: 0x43505247 ("CPRG")
+        uint32_t version;            // Version: 1
+        uint32_t count;              // Number of CP registers
+        uint32_t reserved;           // Reserved for future use
+    } cpreg_array_header;
+    
+    cpreg_array_header *header = (cpreg_array_header *)((uint8_t *)buffer + *offset);
+    header->magic = 0x43505247;      // "CPRG"
+    header->version = 1;
+    header->count = arm_cpu->cpreg_array_len;
+    header->reserved = 0;
+    *offset += sizeof(cpreg_array_header);
+    
+    /* Save register IDs */
+    size_t ids_size = arm_cpu->cpreg_array_len * sizeof(uint64_t);
+    memcpy((uint8_t *)buffer + *offset, arm_cpu->cpreg_indexes, ids_size);
+    *offset += ids_size;
+    
+    /* Save register values */
+    size_t values_size = arm_cpu->cpreg_array_len * sizeof(uint64_t);
+    memcpy((uint8_t *)buffer + *offset, arm_cpu->cpreg_values, values_size);
+    *offset += values_size;
+    
+    info_report("Saved dynamic CP register array for CPU %d: %u registers, %lu bytes total",
+                cpu_idx, arm_cpu->cpreg_array_len, 
+                sizeof(cpreg_array_header) + ids_size + values_size);
+    
+    /* Log some sample registers for debugging */
+    if (arm_cpu->cpreg_array_len > 0) {
+        info_report("  Sample CP registers: [0]=0x%016lx:0x%016lx, [1]=0x%016lx:0x%016lx",
+                    arm_cpu->cpreg_indexes[0], arm_cpu->cpreg_values[0],
+                    arm_cpu->cpreg_array_len > 1 ? arm_cpu->cpreg_indexes[1] : 0,
+                    arm_cpu->cpreg_array_len > 1 ? arm_cpu->cpreg_values[1] : 0);
+    }
+}
+
+/*
+ * Restore dynamic CP register array
+ * 
+ * This function restores the CP registers saved by checkpoint_save_dynamic_cpregs.
+ * It works by:
+ * 1. Loading the (register_id, value) pairs from checkpoint
+ * 2. Populating arm_cpu->cpreg_indexes and cpreg_values arrays
+ * 3. Calling write_list_to_cpustate() to write values back to CPU state
+ * 
+ * NOTE: This function is reserved for future checkpoint restore functionality.
+ * Currently unused but kept for API completeness.
+ */
+__attribute__((unused))
+static void checkpoint_restore_dynamic_cpregs(int cpu_idx, const void *buffer, size_t *offset)
+{
+    CPUState *cpu = qemu_get_cpu(cpu_idx);
+    if (!cpu) {
+        return;
+    }
+
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    
+    /* Read header */
+    typedef struct {
+        uint32_t magic;
+        uint32_t version;
+        uint32_t count;
+        uint32_t reserved;
+    } cpreg_array_header;
+    
+    const cpreg_array_header *header = (const cpreg_array_header *)((const uint8_t *)buffer + *offset);
+    
+    /* Validate magic number */
+    if (header->magic != 0x43505247) {
+        error_report("Invalid CP register array magic for CPU %d: 0x%08x (expected 0x43505247)",
+                     cpu_idx, header->magic);
+        return;
+    }
+    
+    /* Validate version */
+    if (header->version != 1) {
+        error_report("Unsupported CP register array version for CPU %d: %u (expected 1)",
+                     cpu_idx, header->version);
+        return;
+    }
+    
+    *offset += sizeof(cpreg_array_header);
+    
+    /* Validate count - must not exceed allocated array size */
+    if (header->count > arm_cpu->cpreg_array_len) {
+        warn_report("CP register count %u exceeds allocated size %d for CPU %d, truncating",
+                    header->count, arm_cpu->cpreg_array_len, cpu_idx);
+    }
+    
+    uint32_t count = header->count < arm_cpu->cpreg_array_len ? 
+                     header->count : arm_cpu->cpreg_array_len;
+    
+    /* Load register IDs */
+    size_t ids_size = count * sizeof(uint64_t);
+    memcpy(arm_cpu->cpreg_indexes, (const uint8_t *)buffer + *offset, ids_size);
+    *offset += header->count * sizeof(uint64_t);  // Skip full array in checkpoint
+    
+    /* Load register values */
+    size_t values_size = count * sizeof(uint64_t);
+    memcpy(arm_cpu->cpreg_values, (const uint8_t *)buffer + *offset, values_size);
+    *offset += header->count * sizeof(uint64_t);  // Skip full array in checkpoint
+    
+    arm_cpu->cpreg_array_len = count;
+    
+    /* Write the loaded values back to CPU state */
+    if (!write_list_to_cpustate(arm_cpu)) {
+        error_report("Failed to write CP register list to CPU state for CPU %d", cpu_idx);
+        return;
+    }
+    
+    info_report("Restored dynamic CP register array for CPU %d: %u registers loaded",
+                cpu_idx, count);
 }
