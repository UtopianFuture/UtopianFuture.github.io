+## 实现流程
+
+### 阶段 1: 基础设施搭建
+
+**目标**: 建立 checkpoint 模块框架
+
+**实现文件**:
+- `include/checkpoint/checkpoint.h` - 头文件定义
+- `checkpoint/checkpoint_core.c` - 核心逻辑
+- `checkpoint/meson.build` - 构建配置
+
+**关键数据结构**:
+
+```c
+// Checkpoint 全局状态
+typedef struct CheckpointState {
+    CheckpointMode mode;           // SimPoint/Uniform/Sync-Uniform
+    uint64_t interval;             // Checkpoint 间隔
+    uint64_t warmup;               // 预热指令数
+    char *output_dir;              // 输出目录
+    char *simpoint_dir;            // SimPoint 文件目录
+    
+    // SimPoint 特定
+    SimPoint *simpoints;           // SimPoint 数组
+    int num_simpoints;             // SimPoint 数量
+    int current_simpoint_idx;      // 当前索引
+    
+    // 多核同步
+    uint64_t sync_interval;        // 同步间隔
+    QemuMutex checkpoint_mutex;    // 互斥锁
+    QemuCond checkpoint_cond;      // 条件变量
+} CheckpointState;
+
+// Checkpoint 文件头
+typedef struct checkpoint_header {
+    uint32_t magic_number;         // 0xdeadbeef
+    uint64_t cpt_offset;           // 64
+    uint32_t cpu_num;              // CPU 数量
+    uint64_t single_core_size;     // 每 CPU 大小
+    uint32_t version;              // 0x20241024
+    uint64_t instruction_count;    // 指令计数
+    uint64_t timestamp;            // 时间戳
+    uint64_t checkpoint_size;      // 文件大小
+} checkpoint_header;  // 64 bytes with padding
+```
+
+### 阶段 2: ARM64 CPU 状态保存
+
+**目标**: 实现 ARM64 架构的完整 CPU 状态序列化
+
+**实现文件**: `target/arm/checkpoint_arm64.c`
+
+**保存的寄存器**:
+
+1. **基本寄存器** (24 bytes)
+   ```c
+   uint64_t pc;      // Program Counter
+   uint64_t sp;      // Stack Pointer  
+   uint64_t pstate;  // Processor State
+   ```
+
+2. **通用寄存器** (248 bytes)
+   ```c
+   uint64_t x_regs[31];  // X0-X30
+   ```
+
+3. **NEON/FP 寄存器** (512 bytes)
+   ```c
+   uint128_t v_regs[32]; // V0-V31
+   ```
+
+4. **系统寄存器** (~488 bytes)
+   - **异常级别寄存器**:
+     - `ELR_EL1/2/3` - Exception Link Register
+     - `SP_EL0/1/2/3` - Stack Pointer (各级别)
+     - `SPSR_EL1/2/3` - Saved Program Status Register
+   
+   - **内存管理**:
+     - `SCTLR_EL1/2/3` - System Control Register
+     - `TCR_EL1/2/3` - Translation Control Register
+     - `TTBR0_EL1/2/3` - Translation Table Base Register 0
+     - `TTBR1_EL1/2/3` - Translation Table Base Register 1
+     - `MAIR_EL1/2/3` - Memory Attribute Indirection Register
+   
+   - **异常处理**:
+     - `VBAR_EL1/2/3` - Vector Base Address Register
+     - `ESR_EL1/2/3` - Exception Syndrome Register
+     - `FAR_EL1/2/3` - Fault Address Register
+   
+   - **其他系统寄存器**:
+     - `CPACR_EL1` - Coprocessor Access Control
+     - `CONTEXTIDR_EL1` - Context ID Register
+     - `TPIDR_EL0/1` - Thread ID Register
+     - `CNTKCTL_EL1` - Counter-timer Kernel Control
+
+**实现示例**:
+
+```c
+void checkpoint_save_arm64_cpu_state(CPUARMState *env, void *buffer, size_t *offset)
+{
+    CheckpointARM64CPUState *cpu_state = (CheckpointARM64CPUState *)buffer;
+    
+    // 基本寄存器
+    cpu_state->pc = env->pc;
+    cpu_state->sp = env->xregs[31];
+    cpu_state->pstate = pstate_read(env);
+    
+    // 通用寄存器
+    for (int i = 0; i < 31; i++) {
+        cpu_state->x_regs[i] = env->xregs[i];
+    }
+    
+    // NEON/FP 寄存器
+    for (int i = 0; i < 32; i++) {
+        cpu_state->v_regs[i] = env->vfp.zregs[i].d[0] | 
+                               ((uint128_t)env->vfp.zregs[i].d[1] << 64);
+    }
+    
+    // 系统寄存器
+    cpu_state->elr_el[1] = env->elr_el[1];
+    cpu_state->sp_el[1] = env->sp_el[1];
+    cpu_state->sctlr_el[1] = env->cp15.sctlr_el[1];
+    cpu_state->tcr_el[1] = env->cp15.tcr_el[1];
+    cpu_state->ttbr0_el[1] = env->cp15.ttbr0_el[1];
+    cpu_state->ttbr1_el[1] = env->cp15.ttbr1_el[1];
+    // ... 60+ 个寄存器
+    
+    *offset += sizeof(CheckpointARM64CPUState);
+}
+```
+
+### 阶段 3: 内存序列化（关键优化）
+
+**目标**: 实现高效的内存快照，避免 OOM
+
+**问题**: 
+- 初始实现使用 64MB 缓冲区
+- 尝试 `g_malloc(16GB)` 导致 SIGKILL (OOM)
+
+**解决方案**: 流式内存序列化
+
+**实现文件**: `checkpoint/checkpoint_memory.c`
+
+**核心思路**:
+1. 不使用中间缓冲区，直接写入文件
+2. 64MB chunk 分块处理
+3. 边压缩边写入
+4. 内存峰值 ~192MB (vs 32GB+)
+
+**实现代码**:
+
+```c
+int checkpoint_serialize_memory_to_file(FILE *fp, uint64_t icount, size_t *total_written)
+{
+    const size_t CHUNK_SIZE = 64 * 1024 * 1024;  // 64MB chunks
+    uint8_t *chunk_buffer = g_malloc(CHUNK_SIZE);
+    uint8_t *compressed_buffer = g_malloc(compressBound(CHUNK_SIZE));
+    
+    /* 写入内存 header */
+    MemoryHeader header = {
+        .magic = 0x4D454D44,  // "MEMD"
+        .num_regions = 0,
+        .total_size = 0,
+        .compressed_size = 0
+    };
+    
+    long header_pos = ftell(fp);
+    fwrite(&header, sizeof(header), 1, fp);
+    *total_written += sizeof(header);
+    
+    /* 预留 32 个区域信息槽位 */
+    MemoryRegionInfo regions[32];
+    memset(regions, 0, sizeof(regions));
+    fwrite(regions, sizeof(regions), 1, fp);
+    *total_written += sizeof(regions);
+    
+    /* 遍历所有内存区域 */
+    int region_count = 0;
+    uint64_t total_compressed = 0;
+    
+    QTAILQ_FOREACH(block, &ram_list.blocks, next) {
+        uint64_t block_size = block->used_length;
+        uint8_t *block_data = qemu_ram_ptr_length(block, 0, &block_size, false);
+        
+        /* 记录区域信息 */
+        regions[region_count].base_addr = block->offset;
+        regions[region_count].size = block_size;
+        regions[region_count].flags = 0;
+        region_count++;
+        
+        /* 分块压缩 */
+        uint64_t offset = 0;
+        while (offset < block_size) {
+            size_t chunk_len = MIN(CHUNK_SIZE, block_size - offset);
+            
+            /* 压缩 chunk */
+            uLongf compressed_len = compressBound(chunk_len);
+            int ret = compress2(compressed_buffer, &compressed_len,
+                              block_data + offset, chunk_len,
+                              Z_BEST_SPEED);
+            
+            /* 写入 chunk header */
+            uint32_t original_size = chunk_len;
+            uint32_t compressed_size = compressed_len;
+            fwrite(&original_size, sizeof(uint32_t), 1, fp);
+            fwrite(&compressed_size, sizeof(uint32_t), 1, fp);
+            
+            /* 写入压缩数据 */
+            fwrite(compressed_buffer, compressed_len, 1, fp);
+            
+            total_compressed += compressed_len + 8;
+            offset += chunk_len;
+            
+            /* 进度报告 (每 256MB) */
+            if (offset % (256 * 1024 * 1024) == 0) {
+                info_report("Memory serialization progress: %lu MB / %lu MB",
+                           offset / (1024 * 1024),
+                           block_size / (1024 * 1024));
+            }
+        }
+    }
+    
+    /* 更新 header */
+    header.num_regions = region_count;
+    header.total_size = total_memory_size;
+    header.compressed_size = total_compressed;
+    
+    fseek(fp, header_pos, SEEK_SET);
+    fwrite(&header, sizeof(header), 1, fp);
+    fwrite(regions, sizeof(regions), 1, fp);
+    fseek(fp, 0, SEEK_END);
+    
+    g_free(chunk_buffer);
+    g_free(compressed_buffer);
+    
+    return 0;
+}
+```
+
+**性能数据**:
+- 处理速度: ~500 MB/s
+- 压缩比: 99.5% (16GB → 86MB)
+- 内存使用: 192MB 峰值
