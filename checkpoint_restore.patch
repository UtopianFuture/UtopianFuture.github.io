+### 阶段 4: SimPoint 集成
+
+**目标**: 支持基于 SimPoint 分析结果创建 checkpoint
+
+**实现文件**: `checkpoint/simpoint_parser.c`
+
+**SimPoint 文件格式**:
+
+`simpoints.txt`:
+```
+0
+105
+233
+319
+```
+
+`simpoint_weights.txt`:
+```
+0.011500 0
+0.988500 1
+0.002833 2
+0.396601 3
+```
+
+**解析实现**:
+
+```c
+int parse_simpoint_files(const char *dir, CheckpointState *cs)
+{
+    char simpoints_path[PATH_MAX];
+    char weights_path[PATH_MAX];
+    
+    snprintf(simpoints_path, sizeof(simpoints_path), "%s/simpoints.txt", dir);
+    snprintf(weights_path, sizeof(weights_path), "%s/simpoint_weights.txt", dir);
+    
+    FILE *fp_sp = fopen(simpoints_path, "r");
+    FILE *fp_wt = fopen(weights_path, "r");
+    
+    // 读取 SimPoint
+    int num_points = 0;
+    SimPoint points[MAX_SIMPOINTS];
+    
+    char line[256];
+    while (fgets(line, sizeof(line), fp_sp) && num_points < MAX_SIMPOINTS) {
+        uint64_t location;
+        if (sscanf(line, "%lu", &location) == 1) {
+            points[num_points].location = location;
+            points[num_points].checkpoint_icount = location * cs->interval;
+            num_points++;
+        }
+    }
+    
+    // 读取权重
+    while (fgets(line, sizeof(line), fp_wt)) {
+        double weight;
+        int id;
+        if (sscanf(line, "%lf %d", &weight, &id) == 2 && id < num_points) {
+            points[id].weight = weight;
+        }
+    }
+    
+    // 按指令计数排序
+    qsort(points, num_points, sizeof(SimPoint), compare_simpoints);
+    
+    cs->simpoints = g_malloc(num_points * sizeof(SimPoint));
+    memcpy(cs->simpoints, points, num_points * sizeof(SimPoint));
+    cs->num_simpoints = num_points;
+    
+    fclose(fp_sp);
+    fclose(fp_wt);
+    
+    return 0;
+}
+```
+
+**Checkpoint 触发逻辑**:
+
+```c
+static bool should_take_simpoint_checkpoint(CheckpointState *cs, uint64_t icount)
+{
+    if (cs->current_simpoint_idx >= cs->num_simpoints) {
+        return false;  // 所有 SimPoint 已完成
+    }
+    
+    SimPoint *sp = &cs->simpoints[cs->current_simpoint_idx];
+    
+    if (icount >= sp->checkpoint_icount) {
+        // 到达 SimPoint
+        cs->current_simpoint_idx++;
+        return true;
+    }
+    
+    return false;
+}
+```
+
+### 阶段 5: 多核同步机制
+
+**目标**: 确保多核环境下 checkpoint 的一致性
+
+**实现文件**: `checkpoint/checkpoint_sync.c`
+
+**同步机制**:
+
+```c
+// 全局同步状态
+typedef struct CheckpointSyncState {
+    int num_cpus;                   // CPU 总数
+    int arrived_cpus;               // 已到达的 CPU 数
+    uint64_t sync_point;            // 同步点
+    QemuMutex sync_mutex;           // 互斥锁
+    QemuCond sync_cond;             // 条件变量
+    bool checkpoint_in_progress;    // 是否正在创建
+} CheckpointSyncState;
+
+// CPU 到达同步点
+void checkpoint_sync_arrive(int cpu_id, uint64_t icount)
+{
+    CheckpointSyncState *sync = get_sync_state();
+    
+    qemu_mutex_lock(&sync->sync_mutex);
+    
+    sync->arrived_cpus++;
+    
+    info_report("CPU %d arrived at sync point (icount=%lu), %d/%d CPUs waiting",
+               cpu_id, icount, sync->arrived_cpus, sync->num_cpus);
+    
+    // 所有 CPU 到达
+    if (sync->arrived_cpus == sync->num_cpus) {
+        info_report("All CPUs synchronized, creating checkpoint...");
+        sync->checkpoint_in_progress = true;
+        qemu_cond_broadcast(&sync->sync_cond);
+    } else {
+        // 等待其他 CPU
+        while (sync->arrived_cpus < sync->num_cpus) {
+            qemu_cond_wait(&sync->sync_cond, &sync->sync_mutex);
+        }
+    }
+    
+    qemu_mutex_unlock(&sync->sync_mutex);
+}
+
+// Checkpoint 完成
+void checkpoint_sync_complete(void)
+{
+    CheckpointSyncState *sync = get_sync_state();
+    
+    qemu_mutex_lock(&sync->sync_mutex);
+    
+    sync->checkpoint_in_progress = false;
+    sync->arrived_cpus = 0;
+    sync->sync_point += sync->sync_interval;
+    
+    qemu_cond_broadcast(&sync->sync_cond);
+    qemu_mutex_unlock(&sync->sync_mutex);
+}
+```
+
+### 阶段 6: Warmup 机制
+
+**目标**: 跳过系统启动阶段，只在程序执行时创建 checkpoint
+
+**实现**:
+
+```c
+void checkpoint_try_take(CPUState *cpu, uint64_t icount)
+{
+    CheckpointState *cs = global_checkpoint_state;
+    
+    if (!cs || !cs->enabled) {
+        return;
+    }
+    
+    // Warmup 阶段 - 每 1 亿条指令报告一次
+    if (icount < cs->warmup) {
+        static uint64_t last_warmup_report = 0;
+        if (icount - last_warmup_report >= 100000000) {
+            info_report("CHECKPOINT DEBUG: Warmup phase - icount=%lu, "
+                       "warmup_limit=%lu, remaining=%lu",
+                       icount, cs->warmup, cs->warmup - icount);
+            last_warmup_report = icount;
+        }
+        return;
+    }
+    
+    // 检查是否应该创建 checkpoint
+    bool should_checkpoint = false;
+    
+    switch (cs->mode) {
+    case CHECKPOINT_MODE_SIMPOINT:
+        should_checkpoint = should_take_simpoint_checkpoint(cs, icount);
+        break;
+    
+    case CHECKPOINT_MODE_UNIFORM:
+        if ((icount - cs->warmup) % cs->interval == 0) {
+            should_checkpoint = true;
+        }
+        break;
+    
+    case CHECKPOINT_MODE_SYNC_UNIFORM:
+        checkpoint_sync_arrive(cpu->cpu_index, icount);
+        if (cpu->cpu_index == 0 && all_cpus_synced()) {
+            should_checkpoint = true;
+        }
+        break;
+    }
+    
+    if (should_checkpoint) {
+        checkpoint_create(icount);
+    }
+}
+```
