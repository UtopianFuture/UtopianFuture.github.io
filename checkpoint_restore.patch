+DEF("checkpoint", HAS_ARG, QEMU_OPTION_checkpoint, \
+    "-checkpoint mode=simpoint|uniform|sync-uniform[,option=value...]\n" \
+    "                enable checkpoint creation with specified mode\n" \
+    "                mode=simpoint: use SimPoint analysis files\n" \
+    "                mode=uniform: uniform interval checkpoints\n" \
+    "                mode=sync-uniform: synchronized uniform checkpoints\n" \
+    "                interval=N: checkpoint every N instructions\n" \
+    "                simpoint-dir=PATH: directory with SimPoint files\n" \
