+/*
+ * QEMU ARM64 Checkpoint - Page Table Explicit Saving
+ * 
+ * This module ensures page tables referenced by TTBR0_EL1 and TTBR1_EL1
+ * are explicitly saved during checkpoint creation, even if they appear
+ * as zeros in regular memory reads.
+ */
+
+#include "qemu/osdep.h"
+#include "checkpoint/checkpoint.h"
+#include "exec/cpu-common.h"
+#include "qemu/error-report.h"
+#include "hw/core/cpu.h"
+#include <zlib.h>
+
+/* ARM64 Page Table Constants */
+#define ARM64_PAGE_SIZE         4096
+#define ARM64_PTRS_PER_TABLE    512
+#define ARM64_TABLE_SIZE        (ARM64_PTRS_PER_TABLE * 8)  /* 4KB */
+
+/* How many levels of page tables to save (4-level paging) */
+#define ARM64_PAGE_TABLE_LEVELS 4
+
+/* Page table entry flags */
+#define ARM64_PTE_VALID         (1ULL << 0)
+#define ARM64_PTE_TABLE         (1ULL << 1)
+#define ARM64_PTE_ADDR_MASK     0x0000FFFFFFFFF000ULL
+
+/* Page table save metadata */
+typedef struct PageTableSaveInfo {
+    uint32_t magic;              /* 0x50544244 "PTBD" */
+    uint32_t version;            /* Version 1 */
+    uint64_t ttbr0_el1;          /* TTBR0_EL1 register value */
+    uint64_t ttbr1_el1;          /* TTBR1_EL1 register value */
+    uint64_t tcr_el1;            /* TCR_EL1 register value */
+    uint32_t num_tables_ttbr0;   /* Number of page tables from TTBR0 */
+    uint32_t num_tables_ttbr1;   /* Number of page tables from TTBR1 */
+    uint64_t total_size;         /* Total bytes of page table data */
+    uint64_t compressed_size;    /* Compressed size */
+    uint64_t reserved[4];        /* For future use */
+} PageTableSaveInfo;
+
+typedef struct PageTableEntry {
+    uint64_t physical_addr;      /* Physical address of the page table */
+    uint32_t level;              /* Page table level (0-3) */
+    uint32_t valid_entries;      /* Number of valid entries */
+    uint64_t data[ARM64_PTRS_PER_TABLE];  /* The actual page table data */
+} PageTableEntry;
+
+/* Get TTBR base address (clear descriptor bits) */
+static inline uint64_t get_ttbr_base(uint64_t ttbr)
+{
+    /* TTBR format: bits [47:1] are address, bit 0 is CnP (Common not Private) */
+    return ttbr & 0x0000FFFFFFFFFFFE;
+}
+
+/* Read page table from physical memory */
+static int read_page_table(uint64_t phys_addr, PageTableEntry *entry)
+{
+    entry->physical_addr = phys_addr;
+    entry->valid_entries = 0;
+    
+    /* Read 4KB page table */
+    cpu_physical_memory_read(phys_addr, entry->data, ARM64_TABLE_SIZE);
+    
+    /* Count valid entries */
+    for (int i = 0; i < ARM64_PTRS_PER_TABLE; i++) {
+        if (entry->data[i] & ARM64_PTE_VALID) {
+            entry->valid_entries++;
+        }
+    }
+    
+    return 0;
+}
+
+/* Recursively walk and save page tables */
+static int walk_page_tables(uint64_t table_base, int level, int max_level,
+                           PageTableEntry *entries, int *count, int max_entries)
+{
+    if (level >= max_level || *count >= max_entries) {
+        return 0;
+    }
+    
+    /* Read current level page table */
+    PageTableEntry current;
+    current.level = level;
+    if (read_page_table(table_base, &current) < 0) {
+        return -1;
+    }
+    
+    /* Save this table */
+    if (*count < max_entries) {
+        memcpy(&entries[*count], &current, sizeof(PageTableEntry));
+        (*count)++;
+    }
+    
+    /* If not at leaf level, recurse into next level tables */
+    if (level < max_level - 1) {
+        for (int i = 0; i < ARM64_PTRS_PER_TABLE; i++) {
+            uint64_t pte = current.data[i];
+            
+            /* Check if valid and points to table (not block mapping) */
+            if ((pte & ARM64_PTE_VALID) && (pte & ARM64_PTE_TABLE)) {
+                uint64_t next_table = pte & ARM64_PTE_ADDR_MASK;
+                
+                /* Recursively walk next level */
+                walk_page_tables(next_table, level + 1, max_level,
+                               entries, count, max_entries);
+            }
+        }
+    }
+    
+    return 0;
+}
+
+/* Get ARM64 system registers directly from CPU state 
+ * This function is implemented in target/arm/checkpoint_arm64.c
+ * to avoid including target-specific headers in common code.
+ * Declaration is in checkpoint/checkpoint.h
+ */
+static void get_arm64_ttbr_values(uint64_t *ttbr0, uint64_t *ttbr1, uint64_t *tcr)
+{
+    /* Initialize to zero */
+    *ttbr0 = 0;
+    *ttbr1 = 0;
+    *tcr = 0;
+    
+    /* Get first CPU */
+    CPUState *cs = first_cpu;
+    if (!cs) {
+        warn_report("No CPU available for reading TTBR values");
+        return;
+    }
+    
+    /* Call target-specific function to read TTBR values */
+    arm64_read_ttbr_values(cs, ttbr0, ttbr1, tcr);
+    
+    if (*ttbr0 || *ttbr1) {
+        info_report("Read TTBR values from CPU state: TTBR0=0x%lx TTBR1=0x%lx TCR=0x%lx",
+                   *ttbr0, *ttbr1, *tcr);
+    }
+}
+
+/* Save page tables explicitly to checkpoint file */
+int checkpoint_save_page_tables_to_file(FILE *fp, size_t *total_written)
+{
+    if (!fp) {
+        error_report("Invalid file pointer for page table save");
+        return -1;
+    }
+    
+    info_report("=== Explicit Page Table Saving ===");
+    
+    /* Get TTBR register values */
+    uint64_t ttbr0_el1, ttbr1_el1, tcr_el1;
+    get_arm64_ttbr_values(&ttbr0_el1, &ttbr1_el1, &tcr_el1);
+    
+    if (ttbr0_el1 == 0 && ttbr1_el1 == 0) {
+        warn_report("TTBR values not available, skipping page table save");
+        
+        /* Write empty header to maintain file format compatibility */
+        PageTableSaveInfo header = {
+            .magic = 0x50544244,
+            .version = 1,
+            .ttbr0_el1 = 0,
+            .ttbr1_el1 = 0,
+            .tcr_el1 = 0,
+            .num_tables_ttbr0 = 0,
+            .num_tables_ttbr1 = 0,
+            .total_size = 0,
+            .compressed_size = 0
+        };
+        
+        if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+            error_report("Failed to write empty page table header");
+            return -1;
+        }
+        *total_written += sizeof(header);
+        
+        return 0;
+    }
+    
+    /* Allocate space for page table entries */
+    #define MAX_PAGE_TABLES 4096  /* Should be enough for most systems */
+    PageTableEntry *ttbr0_entries = g_malloc0(sizeof(PageTableEntry) * MAX_PAGE_TABLES);
+    PageTableEntry *ttbr1_entries = g_malloc0(sizeof(PageTableEntry) * MAX_PAGE_TABLES);
+    
+    /* Walk TTBR0 page tables (user space) */
+    int ttbr0_count = 0;
+    uint64_t ttbr0_base = get_ttbr_base(ttbr0_el1);
+    info_report("Walking TTBR0_EL1 page tables from base 0x%lx...", ttbr0_base);
+    
+    if (ttbr0_base != 0) {
+        walk_page_tables(ttbr0_base, 0, ARM64_PAGE_TABLE_LEVELS,
+                        ttbr0_entries, &ttbr0_count, MAX_PAGE_TABLES);
+        info_report("  Found %d page tables for TTBR0", ttbr0_count);
+    }
+    
+    /* Walk TTBR1 page tables (kernel space) */
+    int ttbr1_count = 0;
+    uint64_t ttbr1_base = get_ttbr_base(ttbr1_el1);
+    info_report("Walking TTBR1_EL1 page tables from base 0x%lx...", ttbr1_base);
+    
+    if (ttbr1_base != 0) {
+        walk_page_tables(ttbr1_base, 0, ARM64_PAGE_TABLE_LEVELS,
+                        ttbr1_entries, &ttbr1_count, MAX_PAGE_TABLES);
+        info_report("  Found %d page tables for TTBR1", ttbr1_count);
+    }
+    
+    /* Prepare header */
+    PageTableSaveInfo header = {
+        .magic = 0x50544244,  /* "PTBD" */
+        .version = 1,
+        .ttbr0_el1 = ttbr0_el1,
+        .ttbr1_el1 = ttbr1_el1,
+        .tcr_el1 = tcr_el1,
+        .num_tables_ttbr0 = ttbr0_count,
+        .num_tables_ttbr1 = ttbr1_count,
+        .total_size = 0,
+        .compressed_size = 0
+    };
+    
+    /* Calculate total size */
+    size_t total_pt_size = (ttbr0_count + ttbr1_count) * sizeof(PageTableEntry);
+    header.total_size = total_pt_size;
+    
+    /* Reserve space for header (will update later) */
+    long header_pos = ftell(fp);
+    if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to write page table header");
+        g_free(ttbr0_entries);
+        g_free(ttbr1_entries);
+        return -1;
+    }
+    *total_written += sizeof(header);
+    
+    /* Compress and write TTBR0 page tables */
+    if (ttbr0_count > 0) {
+        size_t ttbr0_size = ttbr0_count * sizeof(PageTableEntry);
+        uLongf compressed_bound = compressBound(ttbr0_size);
+        void *compressed = g_malloc(compressed_bound);
+        uLongf compressed_size = compressed_bound;
+        
+        int ret = compress2((Bytef *)compressed, &compressed_size,
+                          (const Bytef *)ttbr0_entries, ttbr0_size, Z_BEST_COMPRESSION);
+        
+        if (ret == Z_OK) {
+            /* Write compressed size */
+            if (fwrite(&compressed_size, sizeof(compressed_size), 1, fp) != 1) {
+                error_report("Failed to write TTBR0 compressed size");
+                g_free(compressed);
+                g_free(ttbr0_entries);
+                g_free(ttbr1_entries);
+                return -1;
+            }
+            *total_written += sizeof(compressed_size);
+            
+            /* Write compressed data */
+            if (fwrite(compressed, compressed_size, 1, fp) != 1) {
+                error_report("Failed to write TTBR0 page tables");
+                g_free(compressed);
+                g_free(ttbr0_entries);
+                g_free(ttbr1_entries);
+                return -1;
+            }
+            *total_written += compressed_size;
+            header.compressed_size += compressed_size;
+            
+            info_report("TTBR0 page tables: %zu bytes -> %lu bytes (%.1f%%)",
+                       ttbr0_size, compressed_size,
+                       (compressed_size * 100.0) / ttbr0_size);
+        }
+        
+        g_free(compressed);
+    }
+    
+    /* Compress and write TTBR1 page tables */
+    if (ttbr1_count > 0) {
+        size_t ttbr1_size = ttbr1_count * sizeof(PageTableEntry);
+        uLongf compressed_bound = compressBound(ttbr1_size);
+        void *compressed = g_malloc(compressed_bound);
+        uLongf compressed_size = compressed_bound;
+        
+        int ret = compress2((Bytef *)compressed, &compressed_size,
+                          (const Bytef *)ttbr1_entries, ttbr1_size, Z_BEST_COMPRESSION);
+        
+        if (ret == Z_OK) {
+            /* Write compressed size */
+            if (fwrite(&compressed_size, sizeof(compressed_size), 1, fp) != 1) {
+                error_report("Failed to write TTBR1 compressed size");
+                g_free(compressed);
+                g_free(ttbr0_entries);
+                g_free(ttbr1_entries);
+                return -1;
+            }
+            *total_written += sizeof(compressed_size);
+            
+            /* Write compressed data */
+            if (fwrite(compressed, compressed_size, 1, fp) != 1) {
+                error_report("Failed to write TTBR1 page tables");
+                g_free(compressed);
+                g_free(ttbr0_entries);
+                g_free(ttbr1_entries);
+                return -1;
+            }
+            *total_written += compressed_size;
+            header.compressed_size += compressed_size;
+            
+            info_report("TTBR1 page tables: %zu bytes -> %lu bytes (%.1f%%)",
+                       ttbr1_size, compressed_size,
+                       (compressed_size * 100.0) / ttbr1_size);
+        }
+        
+        g_free(compressed);
+    }
+    
+    /* Update header with actual sizes */
+    long current_pos = ftell(fp);
+    fseek(fp, header_pos, SEEK_SET);
+    if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to update page table header");
+    }
+    fseek(fp, current_pos, SEEK_SET);
+    
+    /* Cleanup */
+    g_free(ttbr0_entries);
+    g_free(ttbr1_entries);
+    
+    info_report("Page table save complete: %d TTBR0 + %d TTBR1 tables, %lu total bytes",
+               ttbr0_count, ttbr1_count, header.compressed_size);
+    info_report("===================================");
+    
+    return 0;
+}
+
+/* Dump page table info for debugging */
+void checkpoint_dump_page_table_info(uint64_t ttbr0, uint64_t ttbr1)
+{
+    info_report("=== Page Table Information ===");
+    info_report("TTBR0_EL1: 0x%016lx (base: 0x%016lx)", ttbr0, get_ttbr_base(ttbr0));
+    info_report("TTBR1_EL1: 0x%016lx (base: 0x%016lx)", ttbr1, get_ttbr_base(ttbr1));
+    
+    /* Try to read first page table entry from each TTBR */
+    if (ttbr0 != 0) {
+        uint64_t ttbr0_base = get_ttbr_base(ttbr0);
+        PageTableEntry entry;
+        if (read_page_table(ttbr0_base, &entry) == 0) {
+            info_report("TTBR0 first table: %d valid entries", entry.valid_entries);
+            
+            /* Show first few entries */
+            int shown = 0;
+            for (int i = 0; i < ARM64_PTRS_PER_TABLE && shown < 5; i++) {
+                if (entry.data[i] & ARM64_PTE_VALID) {
+                    info_report("  [%d] = 0x%016lx", i, entry.data[i]);
+                    shown++;
+                }
+            }
+        }
+    }
+    
+    if (ttbr1 != 0) {
+        uint64_t ttbr1_base = get_ttbr_base(ttbr1);
+        PageTableEntry entry;
+        if (read_page_table(ttbr1_base, &entry) == 0) {
+            info_report("TTBR1 first table: %d valid entries", entry.valid_entries);
+            
+            /* Show first few entries */
+            int shown = 0;
+            for (int i = 0; i < ARM64_PTRS_PER_TABLE && shown < 5; i++) {
+                if (entry.data[i] & ARM64_PTE_VALID) {
+                    info_report("  [%d] = 0x%016lx", i, entry.data[i]);
+                    shown++;
+                }
+            }
+        }
+    }
+    
+    info_report("==============================");
+}
