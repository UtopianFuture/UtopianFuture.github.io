diff --git a/target/arm/checkpoint-arm64.c b/target/arm/checkpoint-arm64.c
index 19b4213f9..63b148475 100644
--- a/target/arm/checkpoint-arm64.c
+++ b/target/arm/checkpoint-arm64.c
@@ -563,3 +563,79 @@ static void checkpoint_restore_dynamic_cpregs(int cpu_idx, const void *buffer, s
     info_report("Restored dynamic CP register array for CPU %d: %u registers loaded",
                 cpu_idx, count);
 }
+
+/**
+ * arm64_read_ttbr_values - Read TTBR0_EL1, TTBR1_EL1, TCR_EL1 from ARM CPU
+ * @cs: CPU state object
+ * @ttbr0: Output pointer for TTBR0_EL1 value
+ * @ttbr1: Output pointer for TTBR1_EL1 value  
+ * @tcr: Output pointer for TCR_EL1 value
+ *
+ * This function accesses ARM-specific CPU structures to read page table
+ * base registers. It is called from checkpoint code (common code) which
+ * cannot directly include target-specific headers.
+ */
+void arm64_read_ttbr_values(CPUState *cs, uint64_t *ttbr0, uint64_t *ttbr1, uint64_t *tcr)
+{
+    if (!cs || !ttbr0 || !ttbr1 || !tcr) {
+        return;
+    }
+    
+    /* Cast to ARM CPU */
+    ARMCPU *cpu = ARM_CPU(cs);
+    if (!cpu) {
+        return;
+    }
+    
+    CPUARMState *env = &cpu->env;
+    
+    /* Read TTBR0_EL1, TTBR1_EL1, TCR_EL1 from CPU state
+     * These are AArch64 system registers stored in env->cp15
+     * 
+     * The index [1] means EL1 (Exception Level 1):
+     * - TTBR0_EL1: User space page tables
+     * - TTBR1_EL1: Kernel space page tables  
+     * - TCR_EL1: Translation control register
+     */
+    *ttbr0 = env->cp15.ttbr0_el[1];
+    *ttbr1 = env->cp15.ttbr1_el[1];
+    *tcr = env->cp15.tcr_el[1];
+}
+
+/*
+ * Print critical ARM64 system registers for checkpoint verification
+ * Prints SCTLR_EL1, TCR_EL1, TTBR0_EL1, TTBR1_EL1 during checkpoint creation
+ */
+void checkpoint_print_arm64_system_regs(int cpu_idx)
+{
+    CPUState *cs = qemu_get_cpu(cpu_idx);
+    if (!cs) {
+        return;
+    }
+    
+    ARMCPU *cpu = ARM_CPU(cs);
+    if (!cpu) {
+        return;
+    }
+    
+    CPUARMState *env = &cpu->env;
+    
+    /* Read critical system registers */
+    uint64_t sctlr_el1 = env->cp15.sctlr_el[1];
+    uint64_t tcr_el1 = env->cp15.tcr_el[1];
+    uint64_t ttbr0_el1 = env->cp15.ttbr0_el[1];
+    uint64_t ttbr1_el1 = env->cp15.ttbr1_el[1];
+    uint64_t mair_el1 = env->cp15.mair_el[1];
+    uint64_t esr_el1 = env->cp15.esr_el[1];
+    uint64_t far_el1 = env->cp15.far_el[1];
+    
+    info_report("====== CPU %d System Registers (Checkpoint) ======", cpu_idx);
+    info_report("  SCTLR_EL1  = 0x%016lx  (System Control)", sctlr_el1);
+    info_report("  TCR_EL1    = 0x%016lx  (Translation Control)", tcr_el1);
+    info_report("  TTBR0_EL1  = 0x%016lx  (User Page Table Base)", ttbr0_el1);
+    info_report("  TTBR1_EL1  = 0x%016lx  (Kernel Page Table Base)", ttbr1_el1);
+    info_report("  MAIR_EL1   = 0x%016lx  (Memory Attributes)", mair_el1);
+    info_report("  ESR_EL1    = 0x%016lx  (Exception Syndrome)", esr_el1);
+    info_report("  FAR_EL1    = 0x%016lx  (Fault Address)", far_el1);
+    info_report("==================================================");
+}
