diff --git a/include/checkpoint/checkpoint.h b/include/checkpoint/checkpoint.h
new file mode 100644
index 000000000..92d4c2f93
--- /dev/null
+++ b/include/checkpoint/checkpoint.h
@@ -0,0 +1,172 @@
+/*
+ * QEMU ARM64 Checkpoint Support
+ * Adapted from XiangShan QEMU checkpoint implementation
+ */
+
+#ifndef CHECKPOINT_H
+#define CHECKPOINT_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "qemu/osdep.h"
+
+#define STRING_LEN              100
+#define SIMPOINT_IDX_MAX        100
+#define CPT_MAGIC_NUMBER        0xdeadbeef
+#define CHECKPOINT_VERSION      0x20241024
+
+/* Checkpoint modes */
+typedef enum CheckpointMode {
+    NoCheckpoint = 0,
+    SimpointCheckpointing,
+    UniformCheckpointing,
+    SyncUniformCheckpoint
+} CheckpointMode;
+
+/* Checkpoint header structure */
+typedef struct checkpoint_header {
+    uint32_t magic_number;
+    uint64_t cpt_offset;
+    uint32_t cpu_num;
+    uint64_t single_core_size;
+    uint32_t version;
+    uint64_t instruction_count;
+    uint64_t timestamp;
+    uint64_t checkpoint_size;     /* Total checkpoint size in bytes */
+} checkpoint_header;
+
+/* Per-CPU register layout for ARM64 */
+typedef struct arm64_cpu_state_layout {
+    uint64_t pc;
+    uint64_t sp;
+    uint64_t pstate;
+    uint64_t x_regs[31];      /* X0-X30 */
+    __uint128_t v_regs[32];   /* V0-V31 (NEON/FP registers) */
+    uint64_t system_regs_offset;
+    uint64_t reserved[8];
+} arm64_cpu_state_layout;
+
+/* SimPoint information */
+typedef struct SimpointInfo {
+    GList *cpt_instructions;      /* List of checkpoint instruction counts */
+    GList *weights;               /* List of weights for each simpoint */
+} SimpointInfo;
+
+/* Path manager for checkpoint files */
+typedef struct PathManager {
+    GString *simpoint_path;
+    GString *uniform_path;
+    GList *checkpoint_path_list;
+    GString *output_dir;
+} PathManager;
+
+/* Checkpoint information */
+typedef struct CheckpointInfo {
+    uint64_t next_uniform_point;
+    uint64_t interval;
+    uint64_t warmup_interval;
+} CheckpointInfo;
+
+/* Multi-core synchronization info */
+typedef struct SyncInfo {
+    int cpus;
+    int *online;
+    int online_cpus;
+    
+    uint64_t uniform_sync_limit;
+    int64_t *workload_insns;
+    int64_t *kernel_insns;
+    
+    bool *early_exit;
+    int *checkpoint_end;
+    int *waiting;
+} SyncInfo;
+
+/* Main checkpoint state */
+typedef struct CheckpointState {
+    /* Configuration */
+    CheckpointMode mode;
+    uint64_t cpt_interval;
+    uint64_t warmup_interval;
+    uint64_t sync_interval;
+    
+    /* Runtime state */
+    SimpointInfo simpoint_info;
+    PathManager path_manager;
+    CheckpointInfo checkpoint_info;
+    SyncInfo sync_info;
+    
+    /* Control flags */
+    bool enabled;
+    bool simpoint_exit;
+    uint64_t global_mtime;
+    
+    /* Memory buffer for checkpoint data */
+    void *checkpoint_buffer;
+    size_t buffer_size;
+} CheckpointState;
+
+/* Function pointers for checkpoint operations */
+typedef struct CheckpointFunctions {
+    uint64_t (*get_cpt_limit_instructions)(CheckpointState *cs);
+    uint64_t (*get_sync_limit_instructions)(CheckpointState *cs, int cpu_idx);
+    void (*try_take_cpt)(CheckpointState *cs, uint64_t icount, int cpu_idx, bool exit_sync_period);
+    void (*after_take_cpt)(CheckpointState *cs, int cpu_idx);
+    void (*update_cpt_limit_instructions)(CheckpointState *cs, uint64_t icount);
+    void (*update_sync_limit_instructions)(CheckpointState *cs);
+} CheckpointFunctions;
+
+/* Global checkpoint state */
+extern CheckpointState *global_checkpoint_state;
+
+/* Initialization and cleanup */
+void checkpoint_init(int num_cpus, const char *simpoint_path, 
+                    CheckpointMode mode, uint64_t interval,
+                    uint64_t warmup, uint64_t sync_interval);
+void checkpoint_cleanup(void);
+
+/* SimPoint file parsing */
+int checkpoint_parse_simpoint_files(const char *simpoint_dir, const char *workload_name);
+
+/* Checkpoint creation */
+void checkpoint_try_take(uint64_t icount, int cpu_idx, bool exit_sync_period);
+void checkpoint_create(uint64_t icount, int cpu_idx, int num_cpus);
+void checkpoint_serialize_cpu(int cpu_idx, void *buffer, size_t *offset);
+void checkpoint_serialize_memory(void *buffer, size_t *offset, uint64_t icount);
+int checkpoint_serialize_memory_to_file(FILE *fp, size_t *total_written, uint64_t icount);
+void checkpoint_serialize_devices(void *buffer, size_t *offset);
+int checkpoint_restore_memory(void *buffer, size_t *offset);
+void checkpoint_dump_memory_stats(void);
+
+/* Checkpoint file I/O */
+int checkpoint_load_from_file(const char *filename);
+int checkpoint_verify_file(const char *filename);
+
+/* Multi-core synchronization */
+void checkpoint_sync_init(int num_cpus);
+void checkpoint_sync_cpus(uint64_t icount, int cpu_idx, bool exit_sync_period);
+bool checkpoint_should_wait(uint64_t icount, int cpu_idx, bool early_exit);
+void checkpoint_update_sync_limit(void);
+void checkpoint_cpu_online(int cpu_idx);
+void checkpoint_cpu_offline(int cpu_idx);
+void checkpoint_update_insn_count(int cpu_idx, uint64_t insn_count);
+void checkpoint_mark_kernel_boundary(int cpu_idx, uint64_t insn_count);
+bool checkpoint_is_early_exit(int cpu_idx);
+void checkpoint_set_early_exit(int cpu_idx, bool early_exit);
+
+/* Utility functions */
+uint64_t checkpoint_get_next_simpoint(void);
+void checkpoint_set_exit_flag(void);
+bool checkpoint_should_exit(void);
+const char *checkpoint_get_output_path(uint64_t icount);
+
+/* ARM64 specific functions */
+void checkpoint_save_arm64_cpu_state(int cpu_idx, void *buffer, size_t *offset);
+void checkpoint_save_arm64_system_regs(int cpu_idx, void *buffer, size_t *offset);
+
+/* Command-line interface */
+int checkpoint_parse_cmdline(QemuOpts *opts, int num_cpus);
+void checkpoint_print_help(void);
+extern QemuOptsList qemu_checkpoint_opts;
+
+#endif /* CHECKPOINT_H */
