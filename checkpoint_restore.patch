+    -checkpoint mode=uniform,interval=10000000,warmup=50000000,output-dir=/data/spec_cpts \
+    -icount shift=0
+```
+
+### 示例 2: CoreMark SimPoint
+
+```bash
+# 1. 准备 SimPoint 配置
+cat > /tmp/simpoints.txt << EOF
+0
+105
+EOF
+
+cat > /tmp/simpoint_weights.txt << EOF
+0.011500 0
+0.988500 1
+EOF
+
+# 2. 运行 checkpoint 创建
+./qemu-system-aarch64 \
+    -M virt -cpu cortex-a72 -smp 1 -m 16G \
+    -kernel vmlinux \
+    -drive file=rootfs.qcow2,format=qcow2,if=virtio \
+    -nographic \
+    -checkpoint mode=simpoint,interval=100000000,simpoint-dir=/tmp,warmup=3000000,output-dir=/data/coremark_cpts \
+    -icount shift=0
+
+# 3. 解析结果
+for f in /data/coremark_cpts/*/*.bin; do
+    echo "=== $f ==="
+    python3 parse_checkpoint.py "$f" | head -30
+done
+```
