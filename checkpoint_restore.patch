@@ -0,0 +1,526 @@
+/*
+ * QEMU ARM64 Checkpoint - Memory Serialization with ZSTD Compression
+ * Improved version using zstd for better compression ratio and speed
+ * Reference: XiangShan QEMU serializer_utils.c
+ */
+
+#include "qemu/osdep.h"
+#include "checkpoint/checkpoint.h"
+#include "system/ramblock.h"
+#include "exec/ramlist.h"
+#include "exec/cpu-common.h"
+#include "qemu/error-report.h"
+#include <zstd.h>
+
+/* Configuration */
+#define USE_ZSTD_COMPRESS
+#define ZSTD_COMPRESSION_LEVEL 3      /* 1-22, higher = better compression but slower */
+#define MEMORY_CHUNK_SIZE (64 * 1024 * 1024)  /* 64MB chunks for streaming */
+
+/* Memory region information */
+typedef struct MemoryRegionInfo {
+    uint64_t base_addr;
+    uint64_t size;
+    uint32_t flags;
+    uint32_t reserved;
+} MemoryRegionInfo;
+
+/* Memory header for checkpoint file */
+typedef struct MemoryHeader {
+    uint32_t magic;              /* 0x4D454D44 = "MEMD" */
+    uint32_t version;            /* Format version */
+    uint32_t num_regions;        /* Number of memory regions */
+    uint32_t compression_type;   /* 0=none, 1=zlib, 2=zstd */
+    uint64_t total_size;         /* Total uncompressed size */
+    uint64_t compressed_size;    /* Total compressed size */
+    uint64_t icount;             /* Instruction count at checkpoint */
+    uint32_t reserved[8];        /* Reserved for future use */
+} MemoryHeader;
+
+/* Chunk header for each compressed chunk */
+typedef struct ChunkHeader {
+    uint64_t original_size;      /* Original chunk size */
+    uint64_t compressed_size;    /* Compressed chunk size */
+} ChunkHeader;
+
+/*
+ * Serialize memory directly to file using ZSTD streaming compression
+ * This avoids loading entire memory into a buffer (prevents OOM)
+ * 
+ * Advantages over zlib:
+ * - 3-5x faster compression
+ * - 10-30% better compression ratio
+ * - Lower memory overhead
+ * - Streaming compression support
+ */
+int checkpoint_serialize_memory_to_file_zstd(FILE *fp, size_t *total_written, uint64_t icount)
+{
+    if (!fp) {
+        error_report("Invalid file pointer");
+        return -1;
+    }
+    
+    info_report("=============================================================");
+    info_report("Serializing physical memory with ZSTD compression");
+    info_report("Instruction count: %lu", icount);
+    info_report("=============================================================");
+    
+    /* Write memory header (will update later) */
+    MemoryHeader header = {
+        .magic = 0x4D454D44,           /* "MEMD" */
+        .version = 2,                   /* Version 2: ZSTD compression */
+        .num_regions = 0,
+        .compression_type = 2,          /* 2 = ZSTD */
+        .total_size = 0,
+        .compressed_size = 0,
+        .icount = icount,
+    };
+    
+    long header_pos = ftell(fp);
+    if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to write memory header");
+        return -1;
+    }
+    *total_written += sizeof(header);
+    
+    /* Reserve space for region info array (max 32 regions) */
+    MemoryRegionInfo regions[32];
+    memset(regions, 0, sizeof(regions));
+    
+    long regions_pos = ftell(fp);
+    if (fwrite(regions, sizeof(regions), 1, fp) != 1) {
+        error_report("Failed to write regions array");
+        return -1;
+    }
+    *total_written += sizeof(regions);
+    
+    /* Iterate through memory regions */
+    int region_count = 0;
+    uint64_t total_memory_size = 0;
+    uint64_t total_compressed = 0;
+    
+    RAMBlock *block;
+    RAMBLOCK_FOREACH(block) {
+        if (region_count >= 32) {
+            warn_report("Too many memory regions, limiting to 32");
+            break;
+        }
+        
+        uint64_t block_offset = (uint64_t)qemu_ram_block_host_offset(block, block->host);
+        uint64_t block_size = block->used_length;
+        
+        info_report("-------------------------------------------------------------");
+        info_report("Region %d: %s", region_count, block->idstr);
+        info_report("  Base:   0x%016lx", block_offset);
+        info_report("  Size:   %lu bytes (%.2f MB)", block_size, block_size / (1024.0 * 1024.0));
+        
+        /* Record region info */
+        regions[region_count].base_addr = block_offset;
+        regions[region_count].size = block_size;
+        regions[region_count].flags = 0;
+        regions[region_count].reserved = 0;
+        
+        /* 
+         * Process memory in chunks to avoid OOM
+         * XiangShan uses single-pass compression, but for large memory
+         * we use chunked streaming to reduce peak memory usage
+         */
+        uint64_t bytes_remaining = block_size;
+        uint64_t current_offset = block_offset;
+        uint64_t region_compressed = 0;
+        int chunk_count = 0;
+        
+        /* Calculate compression bound for worst case */
+        size_t chunk_compress_bound = ZSTD_compressBound(MEMORY_CHUNK_SIZE);
+        void *compress_buffer = g_malloc(chunk_compress_bound);
+        
+        if (!compress_buffer) {
+            error_report("Failed to allocate compression buffer");
+            return -1;
+        }
+        
+        info_report("  Processing in %d MB chunks...", MEMORY_CHUNK_SIZE / (1024 * 1024));
+        
+        while (bytes_remaining > 0) {
+            uint64_t chunk_size = (bytes_remaining > MEMORY_CHUNK_SIZE) 
+                                  ? MEMORY_CHUNK_SIZE : bytes_remaining;
+            
+            /* Read chunk from physical memory */
+            void *data_buffer = g_malloc(chunk_size);
+            if (!data_buffer) {
+                error_report("Failed to allocate data buffer");
+                g_free(compress_buffer);
+                return -1;
+            }
+            
+            cpu_physical_memory_read(current_offset, data_buffer, chunk_size);
+            
+            /* Compress chunk with ZSTD */
+            size_t compressed_size = ZSTD_compress(
+                compress_buffer, chunk_compress_bound,
+                data_buffer, chunk_size,
+                ZSTD_COMPRESSION_LEVEL
+            );
+            
+            if (ZSTD_isError(compressed_size)) {
+                error_report("ZSTD compression failed: %s", 
+                           ZSTD_getErrorName(compressed_size));
+                g_free(data_buffer);
+                g_free(compress_buffer);
+                return -1;
+            }
+            
+            /* Write chunk header */
+            ChunkHeader chunk_hdr = {
+                .original_size = chunk_size,
+                .compressed_size = compressed_size
+            };
+            
+            if (fwrite(&chunk_hdr, sizeof(chunk_hdr), 1, fp) != 1) {
+                error_report("Failed to write chunk header");
+                g_free(data_buffer);
+                g_free(compress_buffer);
+                return -1;
+            }
+            *total_written += sizeof(chunk_hdr);
+            
+            /* Write compressed data */
+            if (fwrite(compress_buffer, compressed_size, 1, fp) != 1) {
+                error_report("Failed to write compressed data");
+                g_free(data_buffer);
+                g_free(compress_buffer);
+                return -1;
+            }
+            *total_written += compressed_size;
+            
+            region_compressed += sizeof(chunk_hdr) + compressed_size;
+            chunk_count++;
+            
+            /* Progress report (every 256MB or at end) */
+            uint64_t processed = block_size - bytes_remaining + chunk_size;
+            if (processed % (256 * 1024 * 1024) == 0 || bytes_remaining <= chunk_size) {
+                double ratio = (compressed_size * 100.0) / chunk_size;
+                info_report("    Chunk %d: %lu MB -> %lu MB (%.1f%%)",
+                           chunk_count,
+                           chunk_size / (1024 * 1024),
+                           compressed_size / (1024 * 1024),
+                           ratio);
+            }
+            
+            g_free(data_buffer);
+            current_offset += chunk_size;
+            bytes_remaining -= chunk_size;
+        }
+        
+        g_free(compress_buffer);
+        total_compressed += region_compressed;
+        
+        double region_ratio = (region_compressed * 100.0) / block_size;
+        info_report("  Region compressed: %lu -> %lu bytes (%.1f%%)",
+                   block_size, region_compressed, region_ratio);
+        info_report("  Chunks: %d", chunk_count);
+        
+        total_memory_size += block_size;
+        region_count++;
+    }
+    
+    /* Update header with final values */
+    header.num_regions = region_count;
+    header.total_size = total_memory_size;
+    header.compressed_size = total_compressed;
+    
+    /* Seek back and write updated header */
+    long current_pos = ftell(fp);
+    fseek(fp, header_pos, SEEK_SET);
+    if (fwrite(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to update memory header");
+        return -1;
+    }
+    
+    /* Write updated regions array */
+    fseek(fp, regions_pos, SEEK_SET);
+    if (fwrite(regions, sizeof(regions), 1, fp) != 1) {
+        error_report("Failed to update regions array");
+        return -1;
+    }
+    
+    /* Restore file position */
+    fseek(fp, current_pos, SEEK_SET);
+    
+    double total_ratio = (total_compressed * 100.0) / total_memory_size;
+    info_report("=============================================================");
+    info_report("Memory serialization complete");
+    info_report("  Regions:          %d", region_count);
+    info_report("  Original size:    %lu bytes (%.2f GB)", 
+               total_memory_size, total_memory_size / (1024.0 * 1024.0 * 1024.0));
+    info_report("  Compressed size:  %lu bytes (%.2f GB)",
+               total_compressed, total_compressed / (1024.0 * 1024.0 * 1024.0));
+    info_report("  Compression ratio: %.1f%%", total_ratio);
+    info_report("  Space saved:      %.2f GB",
+               (total_memory_size - total_compressed) / (1024.0 * 1024.0 * 1024.0));
+    info_report("=============================================================");
+    
+    return 0;
+}
+
+/*
+ * Restore memory from ZSTD compressed checkpoint
+ */
+int checkpoint_restore_memory_from_file_zstd(FILE *fp, size_t *total_read)
+{
+    if (!fp) {
+        error_report("Invalid file pointer");
+        return -1;
+    }
+    
+    info_report("=============================================================");
+    info_report("Restoring physical memory from ZSTD checkpoint");
+    info_report("=============================================================");
+    
+    /* Read memory header */
+    MemoryHeader header;
+    if (fread(&header, sizeof(header), 1, fp) != 1) {
+        error_report("Failed to read memory header");
+        return -1;
+    }
+    *total_read += sizeof(header);
+    
+    /* Validate header */
+    if (header.magic != 0x4D454D44) {
+        error_report("Invalid memory checkpoint magic: 0x%x", header.magic);
+        return -1;
+    }
+    
+    if (header.compression_type != 2) {
+        error_report("Not a ZSTD compressed checkpoint (type=%d)", header.compression_type);
+        return -1;
+    }
+    
+    info_report("Checkpoint version: %d", header.version);
+    info_report("Regions: %d", header.num_regions);
+    info_report("Original size: %.2f GB", header.total_size / (1024.0 * 1024.0 * 1024.0));
+    info_report("Compressed size: %.2f GB", header.compressed_size / (1024.0 * 1024.0 * 1024.0));
+    info_report("Instruction count: %lu", header.icount);
+    
+    /* Read region info */
+    MemoryRegionInfo regions[32];
+    if (fread(regions, sizeof(regions), 1, fp) != 1) {
+        error_report("Failed to read regions array");
+        return -1;
+    }
+    *total_read += sizeof(regions);
+    
+    /* Restore each region */
+    for (uint32_t i = 0; i < header.num_regions; i++) {
+        uint64_t base_addr = regions[i].base_addr;
+        uint64_t region_size = regions[i].size;
+        
+        info_report("-------------------------------------------------------------");
+        info_report("Restoring region %d:", i);
+        info_report("  Base:   0x%016lx", base_addr);
+        info_report("  Size:   %lu bytes (%.2f MB)", 
+                   region_size, region_size / (1024.0 * 1024.0));
+        
+        uint64_t bytes_remaining = region_size;
+        uint64_t current_offset = base_addr;
+        int chunk_count = 0;
+        
+        /* Allocate decompression buffer (reused for all chunks) */
+        void *decompress_buffer = g_malloc(MEMORY_CHUNK_SIZE);
+        if (!decompress_buffer) {
+            error_report("Failed to allocate decompression buffer");
+            return -1;
+        }
+        
+        while (bytes_remaining > 0) {
+            /* Read chunk header */
+            ChunkHeader chunk_hdr;
+            if (fread(&chunk_hdr, sizeof(chunk_hdr), 1, fp) != 1) {
+                error_report("Failed to read chunk header");
+                g_free(decompress_buffer);
+                return -1;
+            }
+            *total_read += sizeof(chunk_hdr);
+            
+            /* Allocate buffer for compressed data */
+            void *compress_buffer = g_malloc(chunk_hdr.compressed_size);
+            if (!compress_buffer) {
+                error_report("Failed to allocate compression buffer");
+                g_free(decompress_buffer);
+                return -1;
+            }
+            
+            /* Read compressed data */
+            if (fread(compress_buffer, chunk_hdr.compressed_size, 1, fp) != 1) {
+                error_report("Failed to read compressed data");
+                g_free(compress_buffer);
+                g_free(decompress_buffer);
+                return -1;
+            }
+            *total_read += chunk_hdr.compressed_size;
+            
+            /* Decompress chunk */
+            size_t decompressed_size = ZSTD_decompress(
+                decompress_buffer, MEMORY_CHUNK_SIZE,
+                compress_buffer, chunk_hdr.compressed_size
+            );
+            
+            if (ZSTD_isError(decompressed_size)) {
+                error_report("ZSTD decompression failed: %s",
+                           ZSTD_getErrorName(decompressed_size));
+                g_free(compress_buffer);
+                g_free(decompress_buffer);
+                return -1;
+            }
+            
+            if (decompressed_size != chunk_hdr.original_size) {
+                error_report("Decompressed size mismatch: expected %lu, got %zu",
+                           chunk_hdr.original_size, decompressed_size);
+                g_free(compress_buffer);
+                g_free(decompress_buffer);
+                return -1;
+            }
+            
+            /* Write to physical memory */
+            cpu_physical_memory_write(current_offset, decompress_buffer, decompressed_size);
+            
+            g_free(compress_buffer);
+            
+            chunk_count++;
+            current_offset += decompressed_size;
+            bytes_remaining -= decompressed_size;
+            
+            /* Progress report */
+            uint64_t processed = region_size - bytes_remaining;
+            if (processed % (256 * 1024 * 1024) == 0 || bytes_remaining == 0) {
+                info_report("    Progress: %lu / %lu MB (%.1f%%)",
+                           processed / (1024 * 1024),
+                           region_size / (1024 * 1024),
+                           (processed * 100.0) / region_size);
+            }
+        }
+        
+        g_free(decompress_buffer);
+        info_report("  Region restored: %d chunks", chunk_count);
+    }
+    
+    info_report("=============================================================");
+    info_report("Memory restoration complete");
+    info_report("=============================================================");
+    
+    return 0;
+}
+
+/*
+ * XiangShan-style single-pass compression (for comparison)
+ * Uses entire memory compression in one pass
+ * Requires more memory but simpler code
+ */
+int checkpoint_serialize_memory_xiangshan_style(const char *filepath, 
+                                                 void *pmem_addr, 
+                                                 uint64_t pmem_size,
+                                                 uint64_t inst_count)
+{
+    info_report("=============================================================");
+    info_report("XiangShan-style memory serialization");
+    info_report("Path: %s", filepath);
+    info_report("Size: %.2f GB", pmem_size / (1024.0 * 1024.0 * 1024.0));
+    info_report("Instruction count: %lu", inst_count);
+    info_report("=============================================================");
+    
+    /* Calculate compression bound */
+    size_t const compress_buffer_size = ZSTD_compressBound(pmem_size);
+    void *compress_buffer = g_malloc(compress_buffer_size);
+    
+    if (!compress_buffer) {
+        error_report("Failed to allocate compression buffer (%zu bytes)", 
+                    compress_buffer_size);
+        return -1;
+    }
+    
+    info_report("Compressing memory...");
+    
+    /* Compress entire memory in one pass */
+    size_t const compress_size = ZSTD_compress(
+        compress_buffer, compress_buffer_size,
+        pmem_addr, pmem_size,
+        ZSTD_COMPRESSION_LEVEL
+    );
+    
+    if (ZSTD_isError(compress_size)) {
+        error_report("ZSTD compression failed: %s", ZSTD_getErrorName(compress_size));
+        g_free(compress_buffer);
+        return -1;
+    }
+    
+    double ratio = (compress_size * 100.0) / pmem_size;
+    info_report("Compressed: %.2f GB -> %.2f GB (%.1f%%)",
+               pmem_size / (1024.0 * 1024.0 * 1024.0),
+               compress_size / (1024.0 * 1024.0 * 1024.0),
+               ratio);
+    
+    /* Write to file */
+    FILE *fp = fopen(filepath, "wb");
+    if (!fp) {
+        error_report("Failed to open file: %s", filepath);
+        g_free(compress_buffer);
+        return -1;
+    }
+    
+    size_t written = fwrite(compress_buffer, 1, compress_size, fp);
+    if (written != compress_size) {
+        error_report("fwrite failed: %s", strerror(errno));
+        fclose(fp);
+        g_free(compress_buffer);
+        return -1;
+    }
+    
+    fclose(fp);
+    g_free(compress_buffer);
+    
+    info_report("Successfully wrote checkpoint file");
+    info_report("=============================================================");
+    
+    return 0;
+}
+
+/*
+ * Dump memory statistics
+ */
+void checkpoint_dump_memory_stats_zstd(void)
+{
+    size_t total_ram = 0;
+    int block_count = 0;
+    
+    info_report("=============================================================");
+    info_report("Memory Statistics");
+    info_report("=============================================================");
+    
+    RAMBlock *block;
+    RAMBLOCK_FOREACH(block) {
+        total_ram += block->used_length;
+        block_count++;
+        
+        info_report("RAM Block %d: %s", block_count, block->idstr);
+        info_report("  Size: %lu bytes (%.2f MB)", 
+                   block->used_length, 
+                   block->used_length / (1024.0 * 1024.0));
+        info_report("  Host: %p", block->host);
+    }
+    
+    info_report("-------------------------------------------------------------");
+    info_report("Total RAM: %.2f GB in %d blocks", 
+               total_ram / (1024.0 * 1024.0 * 1024.0), block_count);
+    
+    /* Estimate compression sizes */
+    size_t zlib_bound = total_ram * 1.01 + 12;  /* Approximate zlib bound */
+    size_t zstd_bound = ZSTD_compressBound(total_ram);
+    
+    info_report("-------------------------------------------------------------");
+    info_report("Compression estimates:");
+    info_report("  zlib worst case:  %.2f GB", zlib_bound / (1024.0 * 1024.0 * 1024.0));
+    info_report("  zstd worst case:  %.2f GB", zstd_bound / (1024.0 * 1024.0 * 1024.0));
+    info_report("  Typical zstd (30%%): %.2f GB", 
+               (total_ram * 0.3) / (1024.0 * 1024.0 * 1024.0));
+    info_report("=============================================================");
+}
