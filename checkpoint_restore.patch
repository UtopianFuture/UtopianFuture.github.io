new file mode 100644
index 000000000..543021e83
--- /dev/null
+++ b/checkpoint/simpoint_parser.c
@@ -0,0 +1,247 @@
+/*
+ * QEMU ARM64 Checkpoint - SimPoint File Parser
+ * Parse SimPoint analysis results files
+ */
+
+#include "qemu/osdep.h"
+#include "checkpoint/checkpoint.h"
+#include "qemu/error-report.h"
+
+/* Forward declarations */
+static void checkpoint_prepare_output_paths(const char *workload_name);
+#include <glib.h>
+
+/* Parse simpoint files from directory */
+int checkpoint_parse_simpoint_files(const char *simpoint_dir, const char *workload_name)
+{
+    FILE *simpoints_file = NULL;
+    FILE *weights_file = NULL;
+    char simpoints_path[512];
+    char weights_path[512];
+    CheckpointState *cs = global_checkpoint_state;
+    
+    if (!cs || !simpoint_dir) {
+        error_report("Checkpoint state not initialized or invalid simpoint directory");
+        return -1;
+    }
+    
+    /* Construct file paths */
+    snprintf(simpoints_path, sizeof(simpoints_path), "%s/simpoints.txt", simpoint_dir);
+    snprintf(weights_path, sizeof(weights_path), "%s/simpoint_weights.txt", simpoint_dir);
+    
+    /* Open simpoint files */
+    simpoints_file = fopen(simpoints_path, "r");
+    if (!simpoints_file) {
+        /* Try alternative names */
+        snprintf(simpoints_path, sizeof(simpoints_path), "%s/simpoints0.txt", simpoint_dir);
+        simpoints_file = fopen(simpoints_path, "r");
+        if (!simpoints_file) {
+            error_report("Cannot open simpoints file: %s", simpoints_path);
+            return -1;
+        }
+    }
+    
+    weights_file = fopen(weights_path, "r");
+    if (!weights_file) {
+        /* Try alternative names */
+        snprintf(weights_path, sizeof(weights_path), "%s/weights0.txt", simpoint_dir);
+        weights_file = fopen(weights_path, "r");
+        if (!weights_file) {
+            error_report("Cannot open weights file: %s", weights_path);
+            fclose(simpoints_file);
+            return -1;
+        }
+    }
+    
+    info_report("Parsing SimPoint files from %s", simpoint_dir);
+    info_report("  SimPoints file: %s", simpoints_path);
+    info_report("  Weights file: %s", weights_path);
+    
+    /* Initialize lists */
+    cs->simpoint_info.cpt_instructions = NULL;
+    cs->simpoint_info.weights = NULL;
+    
+    /* Parse files line by line */
+    uint64_t simpoint_location, simpoint_id, weight_id;
+    char weight_str[128];
+    int count = 0;
+    
+    while (fscanf(simpoints_file, "%lu %lu\n", &simpoint_location, &simpoint_id) != EOF) {
+        if (fscanf(weights_file, "%s %lu\n", weight_str, &weight_id) == EOF) {
+            error_report("Mismatch between simpoints and weights files");
+            break;
+        }
+        
+        if (weight_id != simpoint_id) {
+            error_report("Warning: SimPoint ID mismatch at line %d (simpoint: %lu, weight: %lu)",
+                        count, simpoint_id, weight_id);
+        }
+        
+        /* Store the checkpoint instruction count (simpoint_location * interval) */
+        uint64_t checkpoint_insn = simpoint_location * cs->cpt_interval;
+        
+        cs->simpoint_info.cpt_instructions = 
+            g_list_append(cs->simpoint_info.cpt_instructions, 
+                         GUINT_TO_POINTER(simpoint_location));
+        
+        GString *weight = g_string_new(weight_str);
+        cs->simpoint_info.weights = 
+            g_list_append(cs->simpoint_info.weights, weight);
+        
+        info_report("  SimPoint %lu: location=%lu, checkpoint @ insn %lu, weight=%s",
+                   simpoint_id, simpoint_location, checkpoint_insn, weight_str);
+        count++;
+        
+        if (count >= SIMPOINT_IDX_MAX) {
+            warn_report("Reached maximum number of simpoints (%d), ignoring rest", 
+                       SIMPOINT_IDX_MAX);
+            break;
+        }
+    }
+    
+    fclose(simpoints_file);
+    fclose(weights_file);
+    
+    if (count == 0) {
+        error_report("No valid simpoints found in files");
+        return -1;
+    }
+    
+    info_report("Successfully parsed %d SimPoints", count);
+    
+    /* Sort the checkpoint instructions in ascending order manually */
+    /* We cannot use g_list_sort due to QEMU restrictions, so sort is done here */
+    GList *sorted = NULL;
+    GList *iter = cs->simpoint_info.cpt_instructions;
+    while (iter) {
+        uint64_t val = GPOINTER_TO_UINT(iter->data);
+        GList *insert_pos = sorted;
+        GList *prev = NULL;
+        
+        /* Find insertion position */
+        while (insert_pos && GPOINTER_TO_UINT(insert_pos->data) < val) {
+            prev = insert_pos;
+            insert_pos = insert_pos->next;
+        }
+        
+        /* Insert at position */
+        if (prev == NULL) {
+            sorted = g_list_prepend(sorted, iter->data);
+        } else {
+            GList *new_node = g_list_alloc();
+            new_node->data = iter->data;
+            new_node->next = insert_pos;
+            if (insert_pos) {
+                new_node->prev = insert_pos->prev;
+                insert_pos->prev = new_node;
+            }
+            prev->next = new_node;
+            new_node->prev = prev;
+        }
+        iter = iter->next;
+    }
+    g_list_free(cs->simpoint_info.cpt_instructions);
+    cs->simpoint_info.cpt_instructions = sorted;
+    
+    /* Prepare output paths for each checkpoint */
+    checkpoint_prepare_output_paths(workload_name);
+    
+    return count;
+}
+
+/* Prepare output directory paths for each checkpoint */
+static void checkpoint_prepare_output_paths(const char *workload_name)
+{
+    CheckpointState *cs = global_checkpoint_state;
+    GList *iterator;
+    int index = 0;
+    
+    if (!cs || !cs->path_manager.output_dir) {
+        error_report("Checkpoint state or output directory not initialized");
+        return;
+    }
+    
+    /* Clear existing path list */
+    if (cs->path_manager.checkpoint_path_list) {
+        g_list_free_full(cs->path_manager.checkpoint_path_list, 
+                        (GDestroyNotify)g_string_free);
+        cs->path_manager.checkpoint_path_list = NULL;
+    }
+    
+    /* Create path for each checkpoint */
+    for (iterator = cs->simpoint_info.cpt_instructions; 
+         iterator != NULL; 
+         iterator = iterator->next, index++) {
+        
+        uint64_t simpoint_loc = GPOINTER_TO_UINT(iterator->data);
+        uint64_t checkpoint_insn = simpoint_loc * cs->cpt_interval;
+        
+        /* Get corresponding weight */
+        GList *weight_item = g_list_nth(cs->simpoint_info.weights, index);
+        const char *weight = weight_item ? 
+            ((GString *)weight_item->data)->str : "0.0";
+        
+        /* Create path: output_dir/checkpoint_insn/checkpoint_insn_weight.gz */
+        GString *checkpoint_path = g_string_new(NULL);
+        g_string_printf(checkpoint_path, "%s/%lu/checkpoint_%lu_w%s.bin",
+                       cs->path_manager.output_dir->str,
+                       checkpoint_insn,
+                       checkpoint_insn,
+                       weight);
+        
+        cs->path_manager.checkpoint_path_list = 
+            g_list_append(cs->path_manager.checkpoint_path_list, checkpoint_path);
+        
+        info_report("  Checkpoint path [%d]: %s", index, checkpoint_path->str);
+    }
+}
+
+/* Get the next simpoint instruction count */
+uint64_t checkpoint_get_next_simpoint(void)
+{
+    CheckpointState *cs = global_checkpoint_state;
+    
+    if (!cs || !cs->simpoint_info.cpt_instructions) {
+        return UINT64_MAX;
+    }
+    
+    GList *first = g_list_first(cs->simpoint_info.cpt_instructions);
+    if (!first) {
+        checkpoint_set_exit_flag();
+        return UINT64_MAX;
+    }
+    
+    uint64_t simpoint_loc = GPOINTER_TO_UINT(first->data);
+    
+    /* Handle special case of location 0 */
+    if (simpoint_loc == 0) {
+        /* Remove this entry and get next */
+        cs->simpoint_info.cpt_instructions = 
+            g_list_remove(cs->simpoint_info.cpt_instructions, first->data);
+        cs->path_manager.checkpoint_path_list = 
+            g_list_remove(cs->path_manager.checkpoint_path_list,
+                         g_list_first(cs->path_manager.checkpoint_path_list)->data);
+        return UINT64_MAX;
+    }
+    
+    return simpoint_loc * cs->cpt_interval;
+}
+
+/* Checkpoint removal is handled in checkpoint_get_next_simpoint */
+
+/* Get current checkpoint output path */
+const char *checkpoint_get_output_path(uint64_t icount)
+{
+    CheckpointState *cs = global_checkpoint_state;
+    
+    if (!cs || !cs->path_manager.checkpoint_path_list) {
+        return NULL;
+    }
+    
+    GList *first = g_list_first(cs->path_manager.checkpoint_path_list);
+    if (!first) {
+        return NULL;
+    }
+    
+    return ((GString *)first->data)->str;
+}
