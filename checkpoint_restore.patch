diff --git a/target/arm/checkpoint-arm64.c b/target/arm/checkpoint-arm64.c
new file mode 100644
index 000000000..166459446
--- /dev/null
+++ b/target/arm/checkpoint-arm64.c
@@ -0,0 +1,201 @@
+/*
+ * QEMU ARM64 Checkpoint - CPU State Serialization
+ * Save and restore ARM64 CPU state for checkpoint/restore
+ *
+ * This file must be compiled in target/arm directory to access ARM-specific headers
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "checkpoint/checkpoint.h"
+#include "qemu/error-report.h"
+#include "internals.h"
+
+/*
+ * Save complete ARM64 CPU state to buffer
+ * This includes all general purpose registers, system registers, and FP/NEON state
+ */
+void checkpoint_save_arm64_cpu_state(int cpu_idx, void *buffer, size_t *offset)
+{
+    CPUState *cpu = qemu_get_cpu(cpu_idx);
+    if (!cpu) {
+        error_report("Failed to get CPU %d for checkpoint", cpu_idx);
+        return;
+    }
+
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    CPUARMState *env = &arm_cpu->env;
+    arm64_cpu_state_layout *state = (arm64_cpu_state_layout *)((uint8_t *)buffer + *offset);
+
+    /* Save Program Counter */
+    state->pc = env->pc;
+
+    /* Save Stack Pointer - need to get the correct SP based on current EL */
+    if (env->pstate & PSTATE_SP) {
+        /* Using SP_ELx */
+        state->sp = env->sp_el[arm_current_el(env)];
+    } else {
+        /* Using SP_EL0 */
+        state->sp = env->xregs[31];
+    }
+
+    /* Save PSTATE */
+    state->pstate = pstate_read(env);
+
+    /* Save general purpose registers X0-X30 */
+    for (int i = 0; i < 31; i++) {
+        state->x_regs[i] = env->xregs[i];
+    }
+
+    /* Save NEON/FP registers V0-V31 (128-bit each) */
+    for (int i = 0; i < 32; i++) {
+        /* ARM uses Q registers which are 128-bit */
+        /* Each Q register is stored in vfp.zregs[i].d[0] and d[1] */
+        state->v_regs[i] = ((__uint128_t)env->vfp.zregs[i].d[0]) |
+                          (((__uint128_t)env->vfp.zregs[i].d[1]) << 64);
+    }
+
+    /* Mark where system registers will be saved */
+    state->system_regs_offset = *offset + sizeof(arm64_cpu_state_layout);
+
+    /* Update offset */
+    *offset += sizeof(arm64_cpu_state_layout);
+
+    /* Save system registers */
+    checkpoint_save_arm64_system_regs(cpu_idx, buffer, offset);
+
+    info_report("Saved ARM64 CPU %d state: PC=0x%lx, SP=0x%lx, PSTATE=0x%lx",
+                cpu_idx, state->pc, state->sp, state->pstate);
+}
+
+/*
+ * Save ARM64 system registers
+ * Includes exception level registers, MMU configuration, etc.
+ */
+void checkpoint_save_arm64_system_regs(int cpu_idx, void *buffer, size_t *offset)
+{
+    CPUState *cpu = qemu_get_cpu(cpu_idx);
+    if (!cpu) {
+        return;
+    }
+
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    CPUARMState *env = &arm_cpu->env;
+    
+    /* Structure to hold system registers */
+    typedef struct {
+        /* Exception Link Registers */
+        uint64_t elr_el[4];
+        
+        /* Stack Pointers for each EL */
+        uint64_t sp_el[4];
+        
+        /* System Control Registers */
+        uint64_t sctlr_el[4];
+        
+        /* Translation Control Registers */
+        uint64_t tcr_el[4];
+        
+        /* Translation Table Base Registers */
+        uint64_t ttbr0_el[4];
+        uint64_t ttbr1_el[4];
+        
+        /* Vector Base Address Registers */
+        uint64_t vbar_el[4];
+        
+        /* Memory Attribute Indirection Registers */
+        uint64_t mair_el[4];
+        
+        /* Exception Syndrome Registers */
+        uint64_t esr_el[4];
+        
+        /* Fault Address Registers */
+        uint64_t far_el[4];
+        
+        /* Current Exception Level */
+        uint32_t current_el;
+        
+        /* FPCR and FPSR */
+        uint32_t fpcr;
+        uint32_t fpsr;
+        
+        /* TPIDR registers */
+        uint64_t tpidr_el[4];
+        
+        /* Other important system state */
+        uint64_t cpacr_el1;
+        uint64_t cptr_el[4];
+    } arm64_system_regs;
+
+    arm64_system_regs *sys_regs = (arm64_system_regs *)((uint8_t *)buffer + *offset);
+    memset(sys_regs, 0, sizeof(arm64_system_regs));
+
+    /* Save Exception Link Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->elr_el[i] = env->elr_el[i];
+    }
+
+    /* Save Stack Pointers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->sp_el[i] = env->sp_el[i];
+    }
+
+    /* Save System Control Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->sctlr_el[i] = env->cp15.sctlr_el[i];
+    }
+
+    /* Save Translation Control Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->tcr_el[i] = env->cp15.tcr_el[i];
+    }
+
+    /* Save Translation Table Base Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->ttbr0_el[i] = env->cp15.ttbr0_el[i];
+        sys_regs->ttbr1_el[i] = env->cp15.ttbr1_el[i];
+    }
+
+    /* Save Vector Base Address Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->vbar_el[i] = env->cp15.vbar_el[i];
+    }
+
+    /* Save Memory Attribute Indirection Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->mair_el[i] = env->cp15.mair_el[i];
+    }
+
+    /* Save Exception Syndrome Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->esr_el[i] = env->cp15.esr_el[i];
+    }
+
+    /* Save Fault Address Registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->far_el[i] = env->cp15.far_el[i];
+    }
+
+    /* Save current EL */
+    sys_regs->current_el = arm_current_el(env);
+
+    /* Save FP Control and Status */
+    sys_regs->fpcr = vfp_get_fpcr(env);
+    sys_regs->fpsr = vfp_get_fpsr(env);
+
+    /* Save TPIDR registers */
+    for (int i = 0; i < 4; i++) {
+        sys_regs->tpidr_el[i] = env->cp15.tpidr_el[i];
+    }
+
+    /* Save other control registers */
+    sys_regs->cpacr_el1 = env->cp15.cpacr_el1;
+    for (int i = 0; i < 4; i++) {
+        sys_regs->cptr_el[i] = env->cp15.cptr_el[i];
+    }
+
+    *offset += sizeof(arm64_system_regs);
+
+    info_report("Saved ARM64 system registers for CPU %d (EL%d)",
+                cpu_idx, sys_regs->current_el);
+}
